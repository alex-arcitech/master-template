{
  "name": "arcitech",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "node node_modules/postcss-cli/index.js css/input.css -o css/output.css",
    "watch:css": "node node_modules/postcss-cli/index.js css/input.css -o css/output.css --watch",
    "watch:content": "node node_modules/chokidar-cli/index.js \"**/*.php\" \"scripts/**/*.js\" -c \"npm run build:css\"",
    "watch:full": "npm run watch:css & npm run watch:content",
    "watch": "npm run watch:css",
    "start": "npm run watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
    "autoprefixer": "^10.4.23",
    "chokidar-cli": "^3.0.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-import-ext-glob": "^2.1.1",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "baseline-browser-mapping": "^2.9.14",
    "browserslist": "^4.28.1",
    "caniuse-lite": "^1.0.30001764",
    "electron-to-chromium": "^1.5.267",
    "esbuild": "^0.27.2",
    "escalade": "^3.2.0",
    "fraction.js": "^5.3.4",
    "nanoid": "^3.3.11",
    "node-releases": "^2.0.27",
    "picocolors": "^1.1.1",
    "postcss-value-parser": "^4.2.0",
    "source-map-js": "^1.2.1",
    "update-browserslist-db": "^1.2.3"
  },
